# ── MARK LVI — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run.

# ── Secrets & Credentials (NEVER commit) ─────────────────────────────────────
# Gemini API keys and per-plugin credentials
config/api_keys.json
# Dashboard TLS private key and certificate
config/certs/
# Linked WhatsApp session storage
config/whatsapp_web/
# Google OAuth and API credentials
*token*.json
token*.json
**/token*.json
*credentials*.json
credentials*.json
**/credentials*.json
client_secret*.json
**/client_secret*.json
.env
.env.*

# ── Backups ──────────────────────────────────────────────────────────────────
backup_original_hud/
backup*/
*.bak

# ── Personal data & databases ────────────────────────────────────────────────
memory/long_term.json
memory/*.db
memory/*.sqlite
*.db
*.sqlite

# ── Voice Biometrics & Models ─────────────────────────────────────────────────
models/
config/voice_profile.npy
*.npy

# ── Python build & cache ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/
